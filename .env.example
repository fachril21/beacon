# Stage 2 backend integration — copy to .env.local and fill in real values.
# Dev-vs-prod parity (PRD.md NFR "Dev environment parity"): the app never
# needs different code between MinIO and AWS S3, only these variables.

# --- Supabase (self-hosted) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser (PRD.md §6 "S3 credentials never
# reach the browser" applies to this key too: bypasses RLS entirely).
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only for running migrations
# (`supabase db push` / `psql -f`), not by the app at runtime.
SUPABASE_DB_URL=

# --- Object storage (S3-compatible: MinIO in dev, AWS S3 in prod) ----------
# Dev (MinIO): http://localhost:9000
# Prod (AWS S3): leave unset to use the AWS SDK's default region endpoint.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=beacon-screenshots
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for MinIO (path-style buckets); AWS S3 should leave this unset/false.
S3_FORCE_PATH_STYLE=true
# Per-upload cap enforced server-side in /api/s3/presign (Epic 12 AC).
S3_MAX_UPLOAD_BYTES=10485760
# Public read base URL the browser uses to render an uploaded screenshot
# (the bucket allows anonymous GET; only uploads are presigned — see
# docker-compose.yml's minio-init service and screenshot-url.ts).
# Dev (MinIO): http://localhost:9000/beacon-screenshots
# Prod (AWS S3): https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_S3_PUBLIC_URL_BASE=
