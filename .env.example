# Stage 2 backend integration — copy to .env.local and fill in real values.
# Dev-vs-prod parity (PRD.md NFR "Dev environment parity"): the app never
# needs different code between S3-compatible providers, only these variables.

# --- Supabase (self-hosted) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser (PRD.md §6 "S3 credentials never
# reach the browser" applies to this key too: bypasses RLS entirely).
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only for running migrations
# (`supabase db push` / `psql -f`), not by the app at runtime.
SUPABASE_DB_URL=
# Postgres schema every Supabase client queries against — all tables/functions
# live under this schema (see supabase/migrations for the schema-rename
# migration); must also be listed in supabase/config.toml's [api].schemas.
NEXT_PUBLIC_SUPABASE_SCHEMA=beacon

# This Supabase project is shared with the "Kerjain" internal platform, and
# auth (including password recovery) is consolidated there. The forgot-password
# email's link must land on Kerjain's reset-password page — same URL for every
# environment, and it must already be in this Supabase project's Auth >
# URL Configuration > Redirect URLs allow-list, or Supabase silently falls
# back to the project's Site URL instead (src/hooks/use-session.tsx).
NEXT_PUBLIC_KERJAIN_RESET_PASSWORD_URL=https://kerjain-liard.vercel.app/reset-password

# --- Object storage (AWS S3) ----------------------------------------------
# Screenshot uploads are presigned PUTs issued by /api/s3/presign and sent
# straight from the browser to the bucket; the object key is then stored on
# the screenshot_blocks row (PROJECT.md §9.3 / PRD.md Epic 12). No file or
# credential passes through Supabase. The bucket needs a CORS rule allowing
# PUT (and GET) from the app origin.
# Leave blank for AWS's default regional endpoint, or set it explicitly as
# https://s3.<region>.amazonaws.com
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave false — real AWS S3 uses virtual-hosted-style URLs (bucket as
# subdomain). Only set true for a path-style emulator such as MinIO.
S3_FORCE_PATH_STYLE=false
# Per-upload cap checked server-side in /api/s3/presign before issuing the
# presigned URL (Epic 12 AC). Not storage-enforced for PUT uploads.
S3_MAX_UPLOAD_BYTES=10485760
# Public read base URL the browser uses to render an uploaded screenshot
# (the bucket/prefix must allow anonymous GET, or be fronted by CloudFront;
# only uploads are presigned — see screenshot-url.ts). Virtual-hosted form:
# https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_S3_PUBLIC_URL_BASE=

# --- Multi-domain routing (Epic 14a — logic implemented, live Vercel/DNS
# verification deferred; see the Stage 2 evidence report) ------------------
# Comma-separated hosts that ARE this app itself, never a custom
# Organization domain (src/middleware.ts, src/lib/organization-resolution.ts).
# Defaults to "localhost,127.0.0.1" when unset. Add the production Vercel
# domain, e.g. "localhost,127.0.0.1,beacon.vercel.app".
NEXT_PUBLIC_APP_HOSTS=localhost,127.0.0.1
